# Copy to .env and edit. .env is gitignored.

# Locale / region used for future region-aware providers (streaming availability, etc.)
REGION=BR

# Where the SQLite catalog, HTTP cache and logs live.
# Default (unset) = %LOCALAPPDATA%\Loom on Windows, ~/.local/share/loom elsewhere.
# Deliberately OUTSIDE the repo: OneDrive/Dropbox sync can lock SQLite files mid-write.
# DATA_DIR=C:\Users\you\AppData\Local\Loom

LOG_LEVEL=INFO

# --- ingest ---
# Which ingesters bootstrap.py runs, comma-separated. See recsys.ingest.registry
# While the Jikan outage lasts, anime_jikan contributes only ~25 items and
# spends ~20s exhausting retries on every run; drop it from this list if that
# noise is not worth the live half of the catalog.
# Order matters: anime_anilist reads the MAL ids anime_mal_csv wrote.
# Order matters: anilist reads ids the mal_csv wrote, manga reads anime
# relations, music reads film/TV crew credits.
INGESTERS=anime_jikan,anime_mal_csv,anime_anilist,manga_anilist,movie_tmdb,tv_tmdb,book_goodbooks,book_openlibrary,music_musicbrainz

JIKAN_BASE_URL=https://api.jikan.moe/v4
JIKAN_TARGET_COUNT=2000
JIKAN_PAGE_SIZE=25
# Jikan public limits: ~3 req/sec and 60 req/min. Do not raise these.
JIKAN_RATE_PER_SEC=3
JIKAN_RATE_PER_MIN=60
JIKAN_MAX_RETRIES=5

# --- MyAnimeList CSV dump (Kaggle) ---
# A static ~14.5k-anime snapshot, used because the Jikan API is serving only
# its warm cache. Downloaded via kagglehub (~2 GB archive, cached under
# ~/.cache/kagglehub) unless MAL_CSV_PATH points at a local file.
MAL_CSV_DATASET=azathoth42/myanimelist
# AnimeList.csv (14478 rows) | anime_filtered.csv (14474) | anime_cleaned.csv (6668)
MAL_CSV_FILENAME=AnimeList.csv
# MAL_CSV_PATH=
# 0 = ingest the whole file
MAL_CSV_TARGET_COUNT=0

# --- AniList (GraphQL, no key) ---
# The source that carries synopses and ranked descriptive tags, which no file in
# the Kaggle archive has. Driven by the MAL ids already in the catalog, so it
# runs AFTER anime_mal_csv and enriches what exists rather than importing more.
# ~290 requests for a 14.5k catalog; roughly ten minutes, then cached on disk.
ANILIST_URL=https://graphql.anilist.co
# 0 = every MAL id in the catalog
ANILIST_TARGET_COUNT=0
# AniList caps a page at 50, and idMal_in takes a list, so 50 anime per request.
ANILIST_PAGE_SIZE=50
# Observed x-ratelimit-limit is 30/min. Do not raise these.
ANILIST_RATE_PER_SEC=1
ANILIST_RATE_PER_MIN=30
ANILIST_MAX_RETRIES=5
# AniList tags are community-ranked 0-100; below this they are weakly agreed.
# The full list is kept in raw_json regardless, so raising it loses nothing.
ANILIST_MIN_TAG_RANK=60

# --- TMDB (movies / TV) ---
# Free, but unlike the other sources it needs a credential:
#   https://www.themoviedb.org/settings/api
# Prefer the v4 read access token. It travels in an Authorization header, so it
# never appears in a URL, a log line, or a cached response envelope on disk.
# The v3 key is the fallback and is a query parameter; it is stripped from cache
# keys for that reason. Both are secrets -- keep them in .env, never .env.example.
TMDB_READ_TOKEN=
TMDB_API_KEY=
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE=https://image.tmdb.org/t/p/w500
# /discover stops at 500 pages of 20, so 10000 is TMDB's own ceiling per sort.
TMDB_TARGET_COUNT=10000
# One request per item for keywords + credits + imdb_id, so a full run is ~10k
# requests. TMDB allows far more than this; there is no reason to push it.
TMDB_RATE_PER_SEC=20
TMDB_RATE_PER_MIN=0
TMDB_MAX_RETRIES=5

# --- goodbooks-10k (books) ---
# Three small CSVs straight from GitHub, no credential, ~5 MB total.
GOODBOOKS_BASE_URL=https://raw.githubusercontent.com/zygmuntz/goodbooks-10k/master
# Point at a local directory holding the three CSVs to skip the download.
# GOODBOOKS_PATH=
GOODBOOKS_TARGET_COUNT=0
# Goodreads shelves are user-defined; a shelf used by fewer readers than this is
# one person's filing habit rather than a description of the book.
GOODBOOKS_MIN_TAG_COUNT=50
GOODBOOKS_MAX_TAGS=20

# --- Open Library (book descriptions) ---
# Keyless. goodbooks-10k ships no synopsis at all, so this supplies the text the
# book domain needs to take part in the cross-domain bridge. Driven by the ISBNs
# already in the catalog, so book_goodbooks runs first.
OPENLIBRARY_URL=https://openlibrary.org
OPENLIBRARY_TARGET_COUNT=0
OPENLIBRARY_MAX_SUBJECTS=25
# A nonprofit on donated infrastructure. This is well inside what they ask for.
OPENLIBRARY_RATE_PER_SEC=5
OPENLIBRARY_RATE_PER_MIN=0
OPENLIBRARY_MAX_RETRIES=6

# --- MusicBrainz + Deezer (music) ---
# Both keyless. This domain is driven by the composers credited in the film/TV
# catalog, so movie_tmdb / tv_tmdb must run first. A general music catalog was
# measured and rejected -- see music_musicbrainz.py for why.
MUSICBRAINZ_URL=https://musicbrainz.org/ws/2
DEEZER_URL=https://api.deezer.com
MUSIC_USE_DEEZER=true
MUSIC_TARGET_COUNT=0
# MusicBrainz scores candidates 0-100; below this a name match is a guess.
MUSICBRAINZ_MIN_SCORE=90
# MusicBrainz asks for at most one request a second. Do not raise this.
MUSICBRAINZ_RATE_PER_SEC=1
MUSICBRAINZ_RATE_PER_MIN=0
MUSICBRAINZ_MAX_RETRIES=5

# --- MyAnimeList user ratings (same Kaggle archive) ---
# ~31.3M user-list entries; the ~19.2M carrying a real score become `ratings`
# rows. Not in INGESTERS by default: it is a one-off ~75 s load that grows the
# database from 34 MB to ~1.3 GB. Run it explicitly:
#     uv run python scripts/bootstrap.py --only anime_mal_ratings
# animelists_cleaned.csv (31.3M rows, sane dates, but only the 6,668-anime
# "cleaned" subset) | UserAnimeList.csv (80M rows, full catalog, epoch dates)
MAL_RATINGS_FILENAME=animelists_cleaned.csv
# MAL_RATINGS_PATH=
# 0 = read the whole file. Counts rows READ, not rows written -- ~39% are
# unrated list entries and are skipped.
MAL_RATINGS_TARGET_COUNT=0

# Cache entries older than this are re-fetched. 0 = never expire.
HTTP_CACHE_TTL_DAYS=30

# --- server ---
HOST=127.0.0.1
# 0 = pick a free ephemeral port at startup (recommended)
PORT=0
