  "title": {
   "romaji": "Hagane no Renkinjutsushi: FULLMETAL ALCHEMIST",
   "english": "Fullmetal Alchemist: Brotherhood",
   "native": "鋼の錬金術師 FULLMETAL ALCHEMIST"
  },
  "synonyms": [
   "FMA",
   "FMAB",
   "Hagaren",
   "الخيميائي الفولاذي",
   "אלכימאי המתכת: אחוות אחים",
   "Full Metal Alchemist: Brotherhood",
